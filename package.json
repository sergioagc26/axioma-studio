{
  "name": "axioma-studio",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "se": "tsx packages/engine/src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "remotion:studio": "remotion studio packages/remotion/src/index.ts",
    "setup": "node scripts/setup.mjs",
    "build:studio": "npm run build -w @axioma/studio",
    "studio": "tsx packages/engine/src/cli.ts studio",
    "studio:red": "tsx packages/engine/src/cli.ts studio --red"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.543",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
